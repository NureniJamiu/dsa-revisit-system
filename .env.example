# ============================================================
# DSA Revisit System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# The .env file is git-ignored and will NOT be committed.
# ============================================================

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# Connection string for PostgreSQL.
# If using Docker Compose, this matches the db service config.
DATABASE_URL=postgres://user:password@localhost:5432/dsa_revisit?sslmode=disable
POSTGRES_PASSWORD=password

# Password for the Postgres container itself (used by docker-compose.yml).
# Must match the password segment of DATABASE_URL above.
POSTGRES_PASSWORD=password

# ----------------------------------------------------------
# Backend Server
# ----------------------------------------------------------
PORT=8080
# Production Frontend URL for CORS (e.g. https://your-app.vercel.app)
FRONTEND_URL=

# ----------------------------------------------------------
# Clerk Authentication
# ----------------------------------------------------------
# Create an app at https://clerk.com and paste your keys below.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Optional: set this if you have a custom domain
# CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev

# ----------------------------------------------------------
# Resend — Email Notifications
# ----------------------------------------------------------
# Leave RESEND_API_KEY empty to run in simulation mode (emails
# are printed to the terminal log instead of being sent).
#
# Create an API key at https://resend.com/api-keys
# EMAIL_FROM must be an address on a domain you've verified with
# Resend (e.g. "ReStack <notifications@yourdomain.com>").

RESEND_API_KEY=
EMAIL_FROM=
# Base URL for email CTA links (defaults to https://re-stack.vercel.app if empty, set to http://localhost:5173 for local dev)
APP_URL=http://localhost:5173


# ----------------------------------------------------------
# Default User (used by SeedDB on first run)
# ----------------------------------------------------------
# Change this to your real email so you receive notifications.
DEFAULT_USER_EMAIL=
DEFAULT_USER_NAME=

# ----------------------------------------------------------
# Admin / Ops
# ----------------------------------------------------------
# Shared secret required (via the X-Admin-Secret header) to call
# POST /api/admin/run-cron, which forces the daily email job for ALL users.
# Leave empty to keep that endpoint permanently disabled (fails closed).
ADMIN_SECRET=
